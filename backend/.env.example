# Database driver selection (mongodb or postgres)
DATABASE_DRIVER="mongodb"

# MongoDB connection
DATABASE_URL="mongodb://localhost:27017/prac"

# PostgreSQL connection (used when DATABASE_DRIVER="postgres")
DATABASE_USERNAME="postgres"
DATABASE_PASSWORD="postgres"
DATABASE_HOST="localhost"
DATABASE_PORT="5432"
DATABASE_NAME="film_db"

# Logging configuration
# Available options: dev, json, tskv
LOG_FORMAT="dev"

# Debug mode
DEBUG="*"